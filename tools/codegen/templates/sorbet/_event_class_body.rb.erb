extend T::Sig

      # A prop marked `override` needs the method it implements to exist already
      include LogStruct::Log::Interfaces::CommonFields
<% if additional_data -%>
      include LogStruct::Log::Interfaces::AdditionalDataField
<% end -%>
<% if add_request_fields -%>
      include LogStruct::Log::Interfaces::RequestFields
<% end -%>

      # Shared/common fields
      <% if source_has_default -%>
      const :source, <%= source_enum %>, default: <%= source_enum %>, override: true
      <% else -%>
      const :source, Source, override: true
      <% end -%>
      const :event, Event, default: Event::<%= event.name %>, override: true
      const :timestamp, Time, factory: -> { Time.now }, override: true
      const :level, Level, default: Level::Info, override: true

<% base_fields.each do |f| -%>
      const :<%= f.prop_name %>, <%= nilable(f.sorbet_type, f.required) %><% if !f.required %>, default: nil<% end %><%= request_field_override(f) %>
<% end -%>
<% if event_only(event).any? -%>

      # Event-specific fields
<% event_only(event).each do |f| -%>
      const :<%= f.prop_name %>, <%= nilable(f.sorbet_type, f.required) %><% if !f.required %>, default: nil<% end %>
<% end -%>
<% end -%>
<% if additional_data -%>

      # Additional data
      const :additional_data, T.nilable(T::Hash[T.any(String, Symbol), T.untyped]), default: nil, override: true
      include LogStruct::Log::Shared::MergeAdditionalDataFields

      FIELD_KEYS = T.let(
        [<%= (base_fields + event_only(event)).map { |f| "LogField::#{f.enum_name}" }.join(", ") %>].to_set(&:serialize).freeze,
        T::Set[Symbol]
      )

      sig { override.returns(T::Set[Symbol]) }
      def field_keys
        FIELD_KEYS
      end
<% end -%>

      # Serialize shared fields
      include LogStruct::Log::Shared::SerializeCommon
<% if add_request_fields -%>
      include LogStruct::Log::Shared::AddRequestFields
<% end -%>

<%= render_partial('_to_h.rb.erb') -%>
