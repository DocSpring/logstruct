extend T::Sig

      # Shared/common fields
      <% if source_has_default -%>
      const :source, <%= source_enum %>, default: <%= source_enum %>
      <% else -%>
      const :source, Source
      <% end -%>
      const :event, Event, default: Event::<%= event.name %>
      const :timestamp, Time, factory: -> { Time.now }
      const :level, Level, default: Level::Info

<% base_fields.each do |f| -%>
      const :<%= f.prop_name %>, <%= nilable(f.sorbet_type, f.required) %><% if !f.required %>, default: nil<% end %>
<% end -%>

      # Event-specific fields
<% event_only(event).each do |f| -%>
      const :<%= f.prop_name %>, <%= nilable(f.sorbet_type, f.required) %><% if !f.required %>, default: nil<% end %>
<% end -%>

      # Additional data
<% if additional_data -%>
      include LogStruct::Log::Interfaces::AdditionalDataField
      const :additional_data, T.nilable(T::Hash[T.any(String, Symbol), T.untyped]), default: nil
      include LogStruct::Log::Shared::MergeAdditionalDataFields
<% end -%>
<% if add_request_fields -%>

      # Request fields (optional)
      include LogStruct::Log::Interfaces::RequestFields
<% end -%>

      # Serialize shared fields
      include LogStruct::Log::Interfaces::CommonFields
      include LogStruct::Log::Shared::SerializeCommon
<% if add_request_fields -%>
      include LogStruct::Log::Shared::AddRequestFields
<% end -%>

<%= render_partial('_to_h.rb.erb') -%>
