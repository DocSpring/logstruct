#
# pkg:gem/bugsnag#lib/bugsnag/stacktrace.rb:9
Bugsnag::Stacktrace::JAVA_BACKTRACE_REGEX = T.let(T.unsafe(nil), Regexp)

# pkg:gem/bugsnag#lib/bugsnag/utility/feature_data_store.rb:1
module Bugsnag::Utility; end

# A container class with a maximum size, that removes oldest items as required.
#
# @api private
#
# pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:6
class Bugsnag::Utility::CircularBuffer
  include ::Enumerable

  # @param max_items [Integer] the initial maximum number of items
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:14
  def initialize(max_items = T.unsafe(nil)); end

  # Adds an item to the circular buffer
  #
  # If this causes the buffer to exceed its maximum items, the oldest item will be removed
  #
  # @param item [Object] the item to add to the buffer
  # @return [self] returns itself to allow method chaining
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:26
  def <<(item); end

  # Iterates over the buffer
  #
  # @yield [Object] sequentially gives stored items to the block
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:36
  def each(&block); end

  # @return [Integer] the current maximum allowable number of items
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:10
  def max_items; end

  # Sets the maximum allowable number of items
  #
  # If the current number of items exceeds the new maximum, oldest items will be removed
  # until this is no longer the case
  #
  # @param new_max_items [Integer] the new allowed item maximum
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:47
  def max_items=(new_max_items); end

  private

  # Trims the buffer down to the current maximum allowable item number
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/circular_buffer.rb:56
  def trim_buffer; end
end

# @api private
#
# pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:3
class Bugsnag::Utility::Duplicator
  class << self
    # Duplicate (deep clone) the given object
    #
    # @param object [Object]
    # @param seen_objects [Hash<String, Object>]
    # @return [Object]
    #
    # pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:11
    def duplicate(object, seen_objects = T.unsafe(nil)); end

    private

    # pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:33
    def duplicate_array(array, seen_objects); end

    # pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:103
    def duplicate_generic_object(object, seen_objects); end

    # pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:48
    def duplicate_hash(hash, seen_objects); end

    # Ranges are immutable but the values they contain may not be
    #
    # For example, a range of "a".."z" can be mutated: range.first.upcase!
    #
    # pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:67
    def duplicate_range(range, seen_objects); end

    # pkg:gem/bugsnag#lib/bugsnag/utility/duplicator.rb:85
    def duplicate_struct(struct, seen_objects); end
  end
end

# @abstract Requires a #feature_flag_delegate method returning a
#   {Bugsnag::Utility::FeatureFlagDelegate}
#
# pkg:gem/bugsnag#lib/bugsnag/utility/feature_data_store.rb:4
module Bugsnag::Utility::FeatureDataStore
  # Add a feature flag with the given name & variant
  #
  # @param name [String]
  # @param variant [String, nil]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_data_store.rb:10
  def add_feature_flag(name, variant = T.unsafe(nil)); end

  # Merge the given array of FeatureFlag instances into the stored feature
  # flags
  #
  # New flags will be appended to the array. Flags with the same name will be
  # overwritten, but their position in the array will not change
  #
  # @param feature_flags [Array<Bugsnag::FeatureFlag>]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_data_store.rb:22
  def add_feature_flags(feature_flags); end

  # Remove the stored flag with the given name
  #
  # @param name [String]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_data_store.rb:30
  def clear_feature_flag(name); end

  # Remove all the stored flags
  #
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_data_store.rb:37
  def clear_feature_flags; end
end

# @api private
#
# pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:3
class Bugsnag::Utility::FeatureFlagDelegate
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:4
  def initialize; end

  # Add a feature flag with the given name & variant
  #
  # @param name [String]
  # @param variant [String, nil]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:23
  def add(name, variant); end

  # Get the feature flags in their JSON representation
  #
  # @example
  #   [
  #     { "featureFlag" => "name", "variant" => "variant" },
  #     { "featureFlag" => "another name" },
  #   ]
  #
  # @return [Array<Hash{String => String}>]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:85
  def as_json; end

  # Remove all the stored flags
  #
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:59
  def clear; end

  # Merge the given array of FeatureFlag instances into the stored feature
  # flags
  #
  # New flags will be appended to the array. Flags with the same name will be
  # overwritten, but their position in the array will not change
  #
  # @param feature_flags [Array<Bugsnag::FeatureFlag>]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:39
  def merge(feature_flags); end

  # Remove the stored flag with the given name
  #
  # @param name [String]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:52
  def remove(name); end

  # Get an array of FeatureFlag instances
  #
  # @example
  #   [
  #     <#Bugsnag::FeatureFlag>,
  #     <#Bugsnag::FeatureFlag>,
  #   ]
  #
  # @return [Array<Bugsnag::FeatureFlag>]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:72
  def to_a; end

  private

  # pkg:gem/bugsnag#lib/bugsnag/utility/feature_flag_delegate.rb:11
  def initialize_dup(original); end
end

# @api private
#
# pkg:gem/bugsnag#lib/bugsnag/utility/metadata_delegate.rb:3
class Bugsnag::Utility::MetadataDelegate
  # Add values to metadata
  #
  # @overload add_metadata(metadata, section, data)
  #   Merges data into the given section of metadata
  #   @param metadata [Hash] The metadata hash to operate on
  #   @param section [String, Symbol]
  #   @param data [Hash]
  #
  # @overload add_metadata(metadata, section, key, value)
  #   Sets key to value in the given section of metadata. If the value is nil
  #   the key will be deleted
  #   @param metadata [Hash] The metadata hash to operate on
  #   @param section [String, Symbol]
  #   @param key [String, Symbol]
  #   @param value
  #
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/metadata_delegate.rb:26
  def add_metadata(metadata, section, key_or_data, value = T.unsafe(nil)); end

  # Clear values from metadata
  #
  # @overload clear_metadata(metadata, section)
  #   Clears the given section of metadata
  #   @param metadata [Hash] The metadata hash to operate on
  #   @param section [String, Symbol]
  #
  # @overload clear_metadata(metadata, section, key)
  #   Clears the key in the given section of metadata
  #   @param metadata [Hash] The metadata hash to operate on
  #   @param section [String, Symbol]
  #   @param key [String, Symbol]
  #
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/metadata_delegate.rb:52
  def clear_metadata(metadata, section, key = T.unsafe(nil)); end

  private

  # Merge new metadata into the existing metadata
  #
  # Any keys with a 'nil' value in the new metadata will be deleted from the
  # existing metadata
  #
  # @param existing_metadata [Hash]
  # @param section [String, Symbol]
  # @param new_metadata [Hash]
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/metadata_delegate.rb:72
  def merge_metadata(existing_metadata, section, new_metadata); end

  # Overwrite the value in metadata's section & key
  #
  # @param metadata [Hash]
  # @param section [String, Symbol]
  # @param key [String, Symbol]
  # @param value
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/utility/metadata_delegate.rb:95
  def overwrite_metadata(metadata, section, key, value); end
end

# nil is a valid metadata value, so we need a sentinel object so we can tell
# if the value parameter has been provided
#
# pkg:gem/bugsnag#lib/bugsnag/utility/metadata_delegate.rb:6
Bugsnag::Utility::MetadataDelegate::NOT_PROVIDED = T.let(T.unsafe(nil), Object)

# pkg:gem/bugsnag#lib/bugsnag/version.rb:2
Bugsnag::VERSION = T.let(T.unsafe(nil), String)
