# pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:2
class Bugsnag::FeatureFlag
  # @param name [String] The name of this feature flags
  # @param variant [String, nil] An optional variant for this flag
  #
  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:15
  def initialize(name, variant = T.unsafe(nil)); end

  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:20
  def ==(other); end

  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:24
  def hash; end

  # Get the name of this feature flag
  #
  # @return [String]
  #
  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:6
  def name; end

  # Convert this flag to a hash
  #
  # @example With no variant
  #   { "featureFlag" => "name" }
  #
  # @example With a variant
  #   { "featureFlag" => "name", "variant" => "variant" }
  #
  # @return [Hash{String => String}]
  #
  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:37
  def to_h; end

  # Check if this flag is valid, i.e. has a name that's a String and a variant
  # that's either nil or a String
  #
  # @return [Boolean]
  #
  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:49
  def valid?; end

  # Get the variant of this feature flag
  #
  # @return [String, nil]
  #
  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:11
  def variant; end

  private

  # Coerce this variant into a valid value (String or nil)
  #
  # If the variant is not already a string or nil, we use #to_s to coerce it.
  # If #to_s raises, the variant will be set to nil
  #
  # @param variant [Object]
  # @return [String, nil]
  #
  # pkg:gem/bugsnag#lib/bugsnag/feature_flag.rb:64
  def coerce_variant(variant); end
end

# pkg:gem/bugsnag#lib/bugsnag/helpers.rb:2
module Bugsnag::Helpers
  class << self
    # Merges r_hash into l_hash recursively, favouring the values in r_hash.
    #
    # Returns a new array consisting of the merged values
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:41
    def deep_merge(l_hash, r_hash); end

    # Merges r_hash into l_hash recursively, favouring the values in r_hash.
    #
    # Overwrites the values in the existing l_hash
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:57
    def deep_merge!(l_hash, r_hash); end

    # Wrapper for trimming stacktraces
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:105
    def extract_exception(payload, &block); end

    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:161
    def get_payload_length(value); end

    # Check if a value is a raw type which should not be trimmed, truncated
    # or converted to a string
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:127
    def is_json_raw_type?(value); end

    # Validate that the serialized JSON string value is below maximum payload
    # length
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:157
    def payload_too_long?(value); end

    # Remove `metaData` from array of `events` within object
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:207
    def remove_metadata_from_events(object); end

    # If possible, convert the provided object to a string and trim to the
    # maximum allowed string length
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:180
    def trim_as_string(text); end

    # Trim the size of value if the serialized JSON value is longer than is
    # accepted by Bugsnag
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:12
    def trim_if_needed(value); end

    # Take the metadata from the events and trim it down
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:115
    def trim_metadata(payload); end

    # Remove all code from stacktraces
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:84
    def trim_stacktrace_code(payload); end

    # Truncate stacktraces
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:95
    def trim_stacktrace_functions(payload); end

    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:190
    def trim_strings_in_array(collection); end

    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:169
    def trim_strings_in_hash(hash); end

    # Trim all strings to be less than the maximum allowed string length
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:142
    def trim_strings_in_value(value); end

    # Shorten array until it fits within the payload size limit when serialized
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:133
    def truncate_array(array); end

    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:215
    def truncate_arrays_in_hash(hash); end

    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:195
    def truncate_arrays_in_value(value); end

    # Truncate exception messages
    #
    # pkg:gem/bugsnag#lib/bugsnag/helpers.rb:75
    def truncate_exception_messages(payload); end
  end
end

