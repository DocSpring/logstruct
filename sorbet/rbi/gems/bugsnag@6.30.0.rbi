  def pause_session; end

  # Resume the current session if it was previously paused. If there is no
  # current session, a new session will be started
  #
  # @see pause_session
  #
  # @return [Boolean] true if a paused session was resumed
  #
  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:81
  def resume_session; end

  # Delivers the current session_counts lists to the session endpoint.
  #
  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:102
  def send_sessions; end

  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:11
  def session_counts; end

  # Starts a new session, storing it on the current thread.
  #
  # This allows Bugsnag to track error rates for a release.
  #
  # @return [void]
  #
  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:39
  def start_session; end

  private

  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:139
  def add_session(min); end

  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:143
  def deliver(session_payload); end

  # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:116
  def start_delivery_thread; end

  class << self
    # Returns the session information for this thread.
    #
    # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:21
    def get_current_session; end

    # Sets the session information for this thread.
    #
    # pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:15
    def set_current_session(session); end
  end
end

# pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:9
Bugsnag::SessionTracker::MUTEX = T.let(T.unsafe(nil), Thread::Mutex)

# pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:8
Bugsnag::SessionTracker::SESSION_PAYLOAD_VERSION = T.let(T.unsafe(nil), String)

# pkg:gem/bugsnag#lib/bugsnag/session_tracker.rb:7
Bugsnag::SessionTracker::THREAD_SESSION = T.let(T.unsafe(nil), String)

# Extracts and attaches Sidekiq job and queue information to an error report
#
# pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:6
class Bugsnag::Sidekiq
  include ::Sidekiq::ServerMiddleware

  # pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:15
  def initialize; end

  # pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:21
  def call(worker, msg, queue); end

  class << self
    # pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:51
    def configure_server(server); end

    # pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:37
    def notify(exception); end

    # pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:47
    def sidekiq_supports_error_handlers; end
  end
end

# pkg:gem/bugsnag#lib/bugsnag/integrations/sidekiq.rb:10
Bugsnag::Sidekiq::FRAMEWORK_ATTRIBUTES = T.let(T.unsafe(nil), Hash)

# pkg:gem/bugsnag#lib/bugsnag/stacktrace.rb:4
module Bugsnag::Stacktrace
  class << self
    # Process a backtrace and the configuration into a parsed stacktrace.
    #
    # @param backtrace [Array, nil] If nil, 'caller' will be used instead
    # @param configuration [Configuration]
    # @return [Array]
    #
    # pkg:gem/bugsnag#lib/bugsnag/stacktrace.rb:17
    def process(backtrace, configuration); end

    # @api private
    #
    # pkg:gem/bugsnag#lib/bugsnag/stacktrace.rb:74
    def vendor_path?(configuration, file_path); end
  end
end

# e.g. "org/jruby/RubyKernel.java:1264:in `catch'"
