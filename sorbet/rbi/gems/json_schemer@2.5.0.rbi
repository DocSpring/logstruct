# op-level2       =  "+" / "#"
# op-level3       =  "." / "/" / ";" / "?" / "&"
# op-reserve      =  "=" / "," / "!" / "@" / "|"
#
# pkg:gem/json_schemer#lib/json_schemer/format/uri_template.rb:19
JSONSchemer::Format::URITemplate::EXPRESSION = T.let(T.unsafe(nil), String)

# expression      =  "{" [ operator ] variable-list "}"
#
# pkg:gem/json_schemer#lib/json_schemer/format/uri_template.rb:20
JSONSchemer::Format::URITemplate::LITERALS = T.let(T.unsafe(nil), String)

# explode         =  "*"
#
# pkg:gem/json_schemer#lib/json_schemer/format/uri_template.rb:8
JSONSchemer::Format::URITemplate::MAX_LENGTH = T.let(T.unsafe(nil), String)

# prefix          =  ":" max-length
#
