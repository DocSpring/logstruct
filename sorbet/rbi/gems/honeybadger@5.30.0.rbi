# Middleware for Rack applications. Any errors raised by the upstream
# application will be delivered to Honeybadger and re-raised.
#
# @example
#   require 'honeybadger/rack/error_notifier'
#
#   app = Rack::Builder.app do
#     run lambda { |env| raise "Rack down" }
#   end
#
#   use Honeybadger::Rack::ErrorNotifier
#
#   run app
#
# pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:21
class Honeybadger::Rack::ErrorNotifier
  extend ::Forwardable

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:24
  def initialize(app, agent = T.unsafe(nil)); end

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:29
  def call(env); end

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:52
  def config(*args, **, &block); end

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:53
  def logger(*args, **, &block); end

  private

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:55
  def agent; end

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:86
  def framework_exception(env); end

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:59
  def ignored_user_agent?(env); end

  # pkg:gem/honeybadger#lib/honeybadger/rack/error_notifier.rb:65
  def notify_honeybadger(exception, env); end
end

