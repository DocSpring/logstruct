# pkg:gem/amazing_print#lib/amazing_print/inspector.rb:15
class AmazingPrint::Inspector
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:29
  def initialize(options = T.unsafe(nil)); end

  # Dispatcher that detects data nesting and invokes object-aware formatter.
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:88
  def awesome(object); end

  # Return true if we are to colorize the output.
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:103
  def colorize?; end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:78
  def current_indentation; end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:82
  def increase_indentation(&); end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:16
  def indentator; end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:16
  def indentator=(_arg0); end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:16
  def options; end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:16
  def options=(_arg0); end

  private

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:192
  def dotfile_readable?(dotfile); end

  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:172
  def find_dotfile; end

  # This method needs to be mocked during testing so that it always loads
  # predictable values
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:185
  def load_dotfile; end

  # Load ~/.aprc file with custom defaults that override default options.
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:200
  def merge_custom_defaults!; end

  # Update @options by first merging the :color hash and then the remaining
  # keys.
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:165
  def merge_options!(options = T.unsafe(nil)); end

  # Format nested data, for example:
  #   arr = [1, 2]; arr << arr
  #   => [1,2, [...]]
  #   hash = { :a => 1 }; hash[:b] = hash
  #   => { :a => 1, :b => {...} }
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:128
  def nested(object); end

  # Turn class name into symbol, ex: Hello::World => :hello_world. Classes
  # that inherit from Array, Hash, File, Dir, and Struct are treated as the
  # base class.
  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:146
  def printable(object); end

  # ---------------------------------------------------------------------------
  #
  # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:138
  def unnested(object); end

  class << self
    # Unload the cached dotfile and load it again.
    #
    # pkg:gem/amazing_print#lib/amazing_print/inspector.rb:23
    def reload_dotfile; end
  end
end

