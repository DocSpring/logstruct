# ------------------------------------------------------------------------------
#
# The following makes it possible to invoke amazing_print while performing
# operations on method arrays, ex:
#
#   ap [].methods - Object.methods
#   ap ''.methods.grep(/!|\?/)
#
# If you could think of a better way please let me know :-)
#
# pkg:gem/amazing_print#lib/amazing_print/core_ext/awesome_method_array.rb:17
module AwesomeMethodArray
  # pkg:gem/amazing_print#lib/amazing_print/core_ext/awesome_method_array.rb:24
  def &(other); end

  # pkg:gem/amazing_print#lib/amazing_print/core_ext/awesome_method_array.rb:18
  def -(other); end

  # Intercepting Array#grep needs a special treatment since grep accepts
  # an optional block.
  #
  # pkg:gem/amazing_print#lib/amazing_print/core_ext/awesome_method_array.rb:34
  def grep(pattern, &blk); end
end

