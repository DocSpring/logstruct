module Kernel
  # pkg:gem/amazing_print#lib/amazing_print/core_ext/kernel.rb:9
  def ai(options = T.unsafe(nil)); end

  # pkg:gem/amazing_print#lib/amazing_print/core_ext/kernel.rb:24
  def amazing_print(object, options = T.unsafe(nil)); end

  # pkg:gem/amazing_print#lib/amazing_print/core_ext/kernel.rb:18
  def awesome_inspect(options = T.unsafe(nil)); end

  private

  # pkg:gem/amazing_print#lib/amazing_print/core_ext/kernel.rb:20
  def ap(object, options = T.unsafe(nil)); end

  class << self
    # pkg:gem/amazing_print#lib/amazing_print/core_ext/kernel.rb:26
    def ap(object, options = T.unsafe(nil)); end
  end
end

class Logger
  include ::AmazingPrint::Logger
end
