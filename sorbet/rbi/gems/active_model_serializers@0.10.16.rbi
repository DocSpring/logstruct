  def serializable_hash(options = T.unsafe(nil)); end

  private

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/attributes.rb:21
  def fields_to_fieldset(fields); end
end

# pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:7
class ActiveModelSerializers::Adapter::Base
  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:49
  def initialize(serializer, options = T.unsafe(nil)); end

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:60
  def as_json(options = T.unsafe(nil)); end

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:64
  def cache_key; end

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:68
  def fragment_cache(cached_hash, non_cached_hash); end

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:47
  def instance_options; end

  # Subclasses that implement this method must first call
  #   options = serialization_options(options)
  #
  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:56
  def serializable_hash(_options = T.unsafe(nil)); end

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:47
  def serializer; end

  private

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:80
  def root; end

  # see https://github.com/rails-api/active_model_serializers/pull/965
  # When <tt>options</tt> is +nil+, sets it to +{}+
  #
  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:76
  def serialization_options(options); end

  class << self
    # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:39
    def cache_key; end

    # Sets the default transform for the adapter.
    #
    # @return [Symbol] the default transform for the adapter
    #
    # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:16
    def default_key_transform; end

    # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:43
    def fragment_cache(cached_hash, non_cached_hash); end

    # Automatically register adapters when subclassing
    #
    # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:9
    def inherited(subclass); end

    # Determines the transform to use in order of precedence:
    #   adapter option, global config, adapter default.
    #
    # @param options [Object]
    # @return [Symbol] the transform to use
    #
    # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:25
    def transform(options); end

    # Transforms the casing of the supplied value.
    #
    # @param value [Object] the value to be transformed
    # @param options [Object] serializable resource options
    # @return [Symbol] the default transform for the adapter
    #
    # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/base.rb:35
    def transform_key_casing!(value, options); end
  end
end

# pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/json.rb:5
class ActiveModelSerializers::Adapter::Json < ::ActiveModelSerializers::Adapter::Base
