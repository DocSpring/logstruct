  def deprecate(name, replacement); end

  class << self
    # pkg:gem/active_model_serializers#lib/active_model_serializers/deprecate.rb:54
    def delegate_and_deprecate(method, delegee); end

    # pkg:gem/active_model_serializers#lib/active_model_serializers/deprecate.rb:53
    def deprecate(name, replacement); end
  end
end

