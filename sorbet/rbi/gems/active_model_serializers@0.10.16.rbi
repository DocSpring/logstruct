  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/json.rb:18
  def meta_key; end

  # pkg:gem/active_model_serializers#lib/active_model_serializers/adapter/json.rb:6
  def serializable_hash(options = T.unsafe(nil)); end
end

