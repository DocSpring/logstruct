  # The fields in +attribute_names+ determines the returned hash.
  # +attributes+ are returned frozen to prevent any expectations that mutation affects
  # the actual values in the model.
  #
  # pkg:gem/active_model_serializers#lib/active_model_serializers/model.rb:67
  def attributes; end

  class << self
    # pkg:gem/active_model_serializers#lib/active_model_serializers/model.rb:57
    def included(base); end
  end
end

