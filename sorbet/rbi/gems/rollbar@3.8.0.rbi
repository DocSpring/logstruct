  # pkg:gem/rollbar#lib/rollbar/notifier.rb:404
  def disable_locals; end

  # pkg:gem/rollbar#lib/rollbar/notifier.rb:400
  def enable_locals; end

  # pkg:gem/rollbar#lib/rollbar/notifier.rb:395
