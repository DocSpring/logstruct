  # pkg:gem/rollbar#lib/rollbar/item/backtrace.rb:112
  def rollbar_lib_gem_dir; end

  # pkg:gem/rollbar#lib/rollbar/item/backtrace.rb:47
  def trace_chain; end

  # pkg:gem/rollbar#lib/rollbar/item/backtrace.rb:65
  def trace_data(current_exception); end
end

