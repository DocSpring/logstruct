# pkg:gem/dalli#lib/dalli/protocol/connection_manager.rb:16
Dalli::Protocol::ConnectionManager::DEFAULTS = T.let(T.unsafe(nil), Hash)

# The longest reply line Dalli reads, in bytes, CRLF included. A meta
# reply header is at most about 500 bytes: "VA <size>" plus its flags,
# the largest being a 250-byte key base64-encoded to 336 bytes, a
# 20-digit CAS, a 32-byte opaque and a few numeric fields. The longest
# stats line (stats settings) carries a file path such as ext_path, up
# to PATH_MAX (4096). 8 KiB leaves room for both, while a server that
# never sends CRLF can't grow the read buffer without bound.
#
# pkg:gem/dalli#lib/dalli/protocol/connection_manager.rb:182
Dalli::Protocol::ConnectionManager::MAX_LINE_BYTES = T.let(T.unsafe(nil), Integer)

# memcached can't store an item larger than 1 GiB (its -I maximum), so a
# reply claiming more (or a negative size) is malformed or hostile.
# Reading allocates the full count up front, so check before reading.
#
# pkg:gem/dalli#lib/dalli/protocol/connection_manager.rb:198
Dalli::Protocol::ConnectionManager::MAX_READ_BYTES = T.let(T.unsafe(nil), Integer)

# Access point for a single Memcached server, accessed via Memcached's meta
# protocol.  Contains logic for managing connection state to the server (retries, etc),
# formatting requests to the server, and unpacking responses.
#
# pkg:gem/dalli#lib/dalli/protocol/meta.rb:14
class Dalli::Protocol::Meta < ::Dalli::Protocol::Base
  # counters are stored raw
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:18
  def response_processor; end

  private

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:70
  def add(key, value, ttl, options); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:92
  def append(key, value); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:204
  def authenticate_connection; end

  # TODO: This is confusing, as there's a cas command in memcached
  # and this isn't it.  Maybe rename?  Maybe eliminate?
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:57
  def cas(key, options = T.unsafe(nil)); end

  # Arithmetic Commands
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:122
  def decr(key, count, ttl, initial); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:130
  def decr_incr(incr, key, delta, ttl, initial); end

  # Like decr_incr with an initial value, without memcached's auto-create:
  # on a miss the counter is added with the initial value (which is
  # returned, as auto-create would), and the add losing a race to another
  # client means the counter now exists, so the incr is tried again. In a
  # quiet block both requests are sent and whichever applies takes effect.
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:148
  def decr_incr_with_add(incr, key, delta, ttl, initial); end

  # Delete Commands
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:113
  def delete(key, cas); end

  # Other Commands
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:170
  def flush(delay = T.unsafe(nil)); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:39
  def gat(key, ttl, options = T.unsafe(nil)); end

  # Retrieval Commands
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:27
  def get(key, options = T.unsafe(nil)); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:126
  def incr(key, count, ttl, initial); end

  # Noop is a keepalive operation but also used to demarcate the end of a set of pipelined commands.
  # We need to read all the responses at once.
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:177
  def noop; end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:97
  def prepend(key, value); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:161
  def quiet_decr_incr_with_add(incr, key, delta, ttl, initial); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:34
  def quiet_get_request(key); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:75
  def replace(key, value, ttl, cas, options); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:190
  def reset_stats; end

  # Storage Commands
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:65
  def set(key, value, ttl, cas, options); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:185
  def stats(info = T.unsafe(nil)); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:47
  def touch(key, ttl); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:195
  def version; end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:103
  def write_append_prepend_req(mode, key, value, ttl = T.unsafe(nil), cas = T.unsafe(nil), _options = T.unsafe(nil)); end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:200
  def write_noop; end

  # pkg:gem/dalli#lib/dalli/protocol/meta.rb:81
  def write_storage_req(mode, key, raw_value, ttl = T.unsafe(nil), cas = T.unsafe(nil), options = T.unsafe(nil)); end
end

# pkg:gem/dalli#lib/dalli/protocol/meta.rb:16
Dalli::Protocol::Meta::COUNTER_ADD_OPTIONS = T.let(T.unsafe(nil), Hash)

# The meta protocol requires that keys be ASCII only, so Unicode keys are
# not supported.  In addition, the use of whitespace in the key is not
# allowed.
# memcached supports the use of base64 hashes for keys containing
# whitespace or non-ASCII characters, provided the 'b' flag is included in the request.
#
# pkg:gem/dalli#lib/dalli/protocol/meta/key_regularizer.rb:12
class Dalli::Protocol::Meta::KeyRegularizer
  class << self
    # pkg:gem/dalli#lib/dalli/protocol/meta/key_regularizer.rb:22
    def decode(encoded_key, base64_encoded); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/key_regularizer.rb:15
    def encode(key); end
  end
end

# pkg:gem/dalli#lib/dalli/protocol/meta/key_regularizer.rb:13
Dalli::Protocol::Meta::KeyRegularizer::WHITESPACE = T.let(T.unsafe(nil), Regexp)

# Class that encapsulates logic for formatting meta protocol requests
# to memcached.
#
# pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:10
class Dalli::Protocol::Meta::RequestFormatter
  class << self
    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:119
    def cas_string(cas); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:77
    def flush(delay: T.unsafe(nil), quiet: T.unsafe(nil)); end

    # Numeric flag values are written straight into the command line, so a
    # value that isn't an integer -- e.g. a String carrying CRLF -- would let
    # the caller inject further memcached commands (GHSA-6wmv-xq9m-fmp7).
    # Converting to Integer means only digits ever reach the wire. Strings
    # are parsed as base 10 so "010" means 10, as memcached would read it,
    # rather than octal 8.
    #
    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:113
    def integer_flag(name, value); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:52
    def meta_arithmetic(key:, delta:, initial:, incr: T.unsafe(nil), cas: T.unsafe(nil), ttl: T.unsafe(nil), base64: T.unsafe(nil), quiet: T.unsafe(nil)); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:43
    def meta_delete(key:, cas: T.unsafe(nil), ttl: T.unsafe(nil), base64: T.unsafe(nil), quiet: T.unsafe(nil)); end

    # Since these are string construction methods, we're going to disable these
    # Rubocop directives.  We really can't make this construction much simpler,
    # and introducing an intermediate object seems like overkill.
    #
    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:19
    def meta_get(key:, value: T.unsafe(nil), return_cas: T.unsafe(nil), ttl: T.unsafe(nil), base64: T.unsafe(nil), quiet: T.unsafe(nil)); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:69
    def meta_noop; end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:29
    def meta_set(key:, value:, bitflags: T.unsafe(nil), cas: T.unsafe(nil), ttl: T.unsafe(nil), mode: T.unsafe(nil), base64: T.unsafe(nil), quiet: T.unsafe(nil)); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:91
    def mode_to_token(mode); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:124
    def parse_to_64_bit_int(val, default); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:84
    def stats(arg = T.unsafe(nil)); end

    # pkg:gem/dalli#lib/dalli/protocol/meta/request_formatter.rb:73
    def version; end
  end
end

# Class that encapsulates logic for processing meta protocol responses
# from memcached.  Includes logic for pulling data from an IO source
# and parsing into local values.  Handles errors on unexpected values.
#
# pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:11
class Dalli::Protocol::Meta::ResponseProcessor
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:25
  def initialize(io_source, value_marshaller); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:208
  def bitflags_from_tokens(tokens); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:222
  def body_len_from_tokens(tokens); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:212
  def cas_from_tokens(tokens); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:182
  def check_value_size!(size); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:112
  def consume_all_responses_until_mn; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:193
  def contains_header?(buf); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:77
  def decr_incr; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:201
  def error_on_unexpected!(expected_codes); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:95
  def flush; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:127
  def full_response_from_buffer(tokens, body, resp_size); end

  # This method returns an array of values used in a pipelined
  # getk process.  The first value is the number of bytes by
  # which to advance the pointer in the buffer.  If the
  # complete response is found in the buffer, this will
  # be the response size.  Otherwise it is zero.
  #
  # The remaining three values in the array are the ResponseHeader,
  # key, and value.
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:146
  def getk_response_from_buffer(buf); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:197
  def header_from_buffer(buf); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:216
  def key_from_tokens(tokens); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:72
  def meta_delete; end

  # raw: true returns the value as stored, without deserializing or
  # decompressing it, whatever flags it was stored with
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:32
  def meta_get_with_value(cache_nils: T.unsafe(nil), raw: T.unsafe(nil)); end

  # raw: true returns the value as stored; see #meta_get_with_value
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:42
  def meta_get_with_value_and_cas(raw: T.unsafe(nil)); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:53
  def meta_get_without_value; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:65
  def meta_set_append_prepend; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:58
  def meta_set_with_cas; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:241
  def next_line_to_tokens; end

  # A zero-size reply has no body unless it's a VA (a hit on an empty value)
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:189
  def no_body?(tokens, body_len); end

  # The size given right after "VA", or 0 when it isn't a number
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:178
  def positional_size(tokens); end

  # Values are read by the size in the VA line, not up to the next CRLF:
  # a value can contain CRLF and can be longer than MAX_LINE_BYTES
  #
  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:248
  def read_data(data_size); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:237
  def read_line; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:101
  def reset; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:85
  def stats; end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:119
  def tokens_from_header_buffer(buf); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:230
  def value_from_tokens(tokens, flag); end

  # pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:107
  def version; end
end

# pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:12
Dalli::Protocol::Meta::ResponseProcessor::EN = T.let(T.unsafe(nil), String)

# pkg:gem/dalli#lib/dalli/protocol/meta/response_processor.rb:13
