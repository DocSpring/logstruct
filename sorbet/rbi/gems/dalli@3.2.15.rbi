  # pkg:gem/dalli#lib/dalli/protocol/binary.rb:140
  def noop; end

  # pkg:gem/dalli#lib/dalli/protocol/binary.rb:87
  def prepend(key, value); end

  # pkg:gem/dalli#lib/dalli/protocol/binary.rb:28
