  def process(keys, &block); end

  # Processes responses from a server.  Returns true if there are no
  # additional responses from this server.
  #
  # pkg:gem/dalli#lib/dalli/pipelined_getter.rb:139
  def process_server(server); end

  # pkg:gem/dalli#lib/dalli/pipelined_getter.rb:120
  def remaining_time(start, timeout); end

  # pkg:gem/dalli#lib/dalli/pipelined_getter.rb:147
  def servers_with_response(servers, timeout); end

  # pkg:gem/dalli#lib/dalli/pipelined_getter.rb:30
  def setup_requests(keys); end
end

# pkg:gem/dalli#lib/dalli/protocol.rb:7
module Dalli::Protocol; end

# Base class for a single Memcached server, containing logic common to all
# protocols.  Contains logic for managing connection state to the server and value
# handling.
#
# pkg:gem/dalli#lib/dalli/protocol/base.rb:15
class Dalli::Protocol::Base
  extend ::Forwardable

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:24
  def initialize(attribs, client_options = T.unsafe(nil)); end

  # Boolean method used by clients of this class to determine if this
  # particular memcached instance is available for use.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:69
  def alive?; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def close(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:20
  def compress_by_default?(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:20
  def compression_min_size(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:20
  def compressor(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def connected?(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def down!(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def hostname(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:77
  def lock!; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:165
  def multi?; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def name(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:18
  def options; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:18
  def options=(_arg0); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:154
  def password; end

  # Abort current pipelined get. Generally used to signal an external
  # timeout during pipelined get.  The underlying socket is
  # disconnected, and the exception is swallowed.
  #
  # Returns nothing.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:130
  def pipeline_abort; end

  # Did the last call to #pipeline_response_setup complete successfully?
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:146
  def pipeline_complete?; end

  # Attempt to receive and parse as many key/value pairs as possible
  # from this server. After #pipeline_response_setup, this should be invoked
  # repeatedly whenever this server's socket is readable until
  # #pipeline_complete?.
  #
  # Returns a Hash of kv pairs received.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:98
  def pipeline_next_responses; end

  # Start reading key/value pairs from this connection. This is usually called
  # after a series of GETKQ commands. A NOOP is sent, and the server begins
  # flushing responses for kv pairs that were found.
  #
  # Returns nothing.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:86
  def pipeline_response_setup; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def port(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:162
  def quiet?; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def raise_down_error(*args, **, &block); end

  # True when this request passed raw: true. A stored value is then
  # returned as stored, never deserialized or decompressed.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:34
  def raw_request?(options); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def reconnect_down_server?(*args, **, &block); end

  # Chokepoint method for error handling and ensuring liveness
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:39
  def request(opkey, *args); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:158
  def require_auth?; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:20
  def serializer(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def sock(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def socket_timeout(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def socket_type(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:79
  def unlock!; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def up!(*args, **, &block); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:150
  def username; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:18
  def weight; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:18
  def weight=(_arg0); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:21
  def write(*args, **, &block); end

  private

  # Drops the rest of this server's replies and closes the connection so
  # nothing unread is left on it. Not a socket failure, so it doesn't count
  # toward socket_max_failures; the keys not read are simply missing.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:292
  def abandon_pipeline; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:227
  def cache_nils?(opts); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:233
  def connect; end

  # Reads the replies still pending from quiet requests before any
  # non-quiet request, which reads a reply of its own. A quiet block reads
  # them at its end, but the connection is shared: another thread or fiber
  # (quiet? is fiber-local) can make a request while the block is still
  # open, and would otherwise read the block's replies as its own.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:178
  def drain_pending_quiet_responses(opkey); end

  # The socket connection to the underlying server is initialized as a side
  # effect of this call.  In fact, this is the ONLY place where that
  # socket connection is initialized.
  #
  # Both this method and connect need to be in this class so we can do auth
  # as required
  #
  # Since this is invoked exclusively in verify_state!, we don't need to worry about
  # thread safety.  Using it elsewhere may require revisiting that assumption.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:219
  def ensure_connected!; end

  # A multi-get only accepts replies for the keys it asked for. With the
  # meta protocol, memcached names an item created by auto-create (ma or mg
  # with N) for a base64-encoded key by its raw bytes, without the b flag;
  # such a key can contain spaces or CR/LF, which split the reply header and
  # make the replies after it parse as different ones. A key that wasn't
  # requested is how that shows up. Only with the verify_reply_keys option,
  # since building the set costs a multi-get about 15%.
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:261
  def expect_reply_keys(keys); end

  # Called after the noop response is received at the end of a set
  # of pipelined gets
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:300
  def finish_pipeline; end

  # Stores a getkq reply's value and returns true, unless its key wasn't
  # requested: then the replies are out of step, so what was read so far is
  # kept, the rest dropped, and false returned to stop reading
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:268
  def keep_reading?(values, key, value, cas); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:311
  def log_marshal_err(key, err); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:316
  def log_unexpected_err(err); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:240
  def pipelined_get(keys); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:307
  def reconnect_on_pipeline_complete!; end

  # Keys compared as bytes; ASCII keys compare equal in any encoding as is
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:285
  def reply_key_form(key); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:250
  def response_buffer; end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:280
  def unexpected_reply_key?(key); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:184
  def verify_allowed_quiet!(opkey); end

  # pkg:gem/dalli#lib/dalli/protocol/base.rb:205
  def verify_pipelined_state(_opkey); end

  # Checks to see if we can execute the specified operation.  Checks
  # whether the connection is in use, and whether the command is allowed
  #
  # pkg:gem/dalli#lib/dalli/protocol/base.rb:194
  def verify_state(opkey); end
end

# pkg:gem/dalli#lib/dalli/protocol/base.rb:171
Dalli::Protocol::Base::ALLOWED_QUIET_OPS = T.let(T.unsafe(nil), Array)

