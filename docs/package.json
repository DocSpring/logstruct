{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/prepare-integration-fixtures.js",
    "build": "node scripts/generate-favicons.js && next build",
    "postbuild": "node scripts/check-internal-links.js",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test:integration && pnpm run e2e",
    "test:integration": "node scripts/prepare-integration-fixtures.js && pnpm run build && jest -c jest.integration.config.ts",
    "e2e": "playwright test",
    "test:watch": "jest --watch",
    "generate-favicons": "node scripts/generate-favicons.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-dialog": "^1.2.0",
