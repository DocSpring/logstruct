module RailsStructuredLogging
  # Rack middleware integration for structured logging
  module Rack
    class << self
      # Set up Rack middleware for structured error logging
      def setup: (untyped app) -> void
    end

    # Custom middleware to enhance Rails error logging with JSON format and request details
    class ErrorHandlingMiddleware
      def initialize: (untyped app) -> void
      def call: (Hash[String, untyped] env) -> Array[Integer, Hash[String, String], Array[String]] | untyped

      private

      def log_event: (Hash[String, untyped] env, event: String, level: Symbol, ?client_ip: String?, **untyped custom_fields) -> void
    end
  end
end 
