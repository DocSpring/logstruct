module RailsStructuredLogging
  # Constants used throughout the gem
  module Constants
    # Default source keys for different components
    SRC_RAILS: Symbol
    SRC_SIDEKIQ: Symbol
    SRC_SHRINE: Symbol
    SRC_ACTIONMAILER: Symbol
    SRC_ACTIVEJOB: Symbol

    # Default event keys for different types of events
    EVT_SECURITY_VIOLATION: Symbol
    EVT_REQUEST_ERROR: Symbol
    EVT_EMAIL_DELIVERY: Symbol
    EVT_JOB_EXECUTION: Symbol
    EVT_FILE_OPERATION: Symbol

    # Security violation types
    VIOLATION_TYPE_IP_SPOOF: Symbol
    VIOLATION_TYPE_CSRF: Symbol
    VIOLATION_TYPE_BLOCKED_HOST: Symbol
  end
end 
