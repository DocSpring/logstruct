module RailsStructuredLogging
  # Lograge integration for structured request logging
  module Lograge
    class << self
      # Set up lograge for structured request logging
      def setup: () -> void

      private

      # Process headers from the event payload
      def process_headers: (untyped event, Hash[Symbol, untyped] options) -> void

      # Apply custom options from the application's configuration
      def apply_custom_options: (untyped event, Hash[Symbol, untyped] options) -> void
    end
  end
end 
