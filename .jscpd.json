{
  "threshold": 0,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/coverage/**",
    "**/coverage_rails/**",
    "**/generated/**",
    "**/.jscpd/**",
    "**/.git/**",
    "**/tmp/**",
    "**/log/**",
    "**/rails_test_app/logstruct_test_app/**",
    "**/docs/.next/**",
    "**/docs/out/**",
    "**/docs/.vercel/**",
    "**/docspring/**",
    "**/terraform-provider-logstruct/**",
    "**/terraform-aws-logstruct/**",
    "**/terraform-example/**",
    "**/convox_racks_terraform/**",
    "**/sorbet/rbi/**",
    "**/vendor/**",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.js",
    "**/*.spec.js"
  ],
  "format": ["javascript", "typescript", "ruby"],
  "minLines": 10,
  "minTokens": 50,
  "output": ".jscpd",
  "exitCode": 1,
  "absolute": false,
  "gitignore": true
}
