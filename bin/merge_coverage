#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

require "simplecov"
require "simplecov-json"
require "fileutils"

# Define paths
PROJECT_ROOT = File.expand_path("..", __dir__)
UNIT_COVERAGE_DIR = File.join(PROJECT_ROOT, "coverage")
RAILS_COVERAGE_DIR = File.join(PROJECT_ROOT, "coverage_rails")
MERGED_COVERAGE_DIR = File.join(PROJECT_ROOT, "site/public/coverage")

# Ensure output directory exists
FileUtils.mkdir_p(MERGED_COVERAGE_DIR)

# Path to JSON result files
unit_json_path = File.join(UNIT_COVERAGE_DIR, ".resultset.json")
rails_json_path = File.join(RAILS_COVERAGE_DIR, ".resultset.json")

if !File.exist?(unit_json_path) || !File.exist?(rails_json_path)
  puts "Error: Missing coverage files:"
  puts "  Unit tests: #{unit_json_path} (exists: #{File.exist?(unit_json_path)})"
  puts "  Rails tests: #{rails_json_path} (exists: #{File.exist?(rails_json_path)})"
  exit 1
end

puts "Merging coverage from:"
puts "  - Unit tests: #{unit_json_path}"
puts "  - Rails tests: #{rails_json_path}"

# Configure SimpleCov for merged output
SimpleCov.configure do
  coverage_dir MERGED_COVERAGE_DIR
end

# Load and merge the results
SimpleCov.collate [unit_json_path, rails_json_path] do
  # Configure formatters within this block
  formatters = [
    SimpleCov::Formatter::HTMLFormatter,
    SimpleCov::Formatter::JSONFormatter
  ]
  formatter SimpleCov::Formatter::MultiFormatter.new(formatters)

  # Use a command name that doesn't trigger the profile lookup
  command_name "Ruby and Rails Tests"
end

puts "Coverage merged successfully!"
puts "Merged coverage report available at: #{MERGED_COVERAGE_DIR}/index.html"
