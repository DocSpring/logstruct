#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "rake"

# Load Rake tasks
load File.expand_path("../Rakefile", __dir__)

# Handle specific test file(s) or patterns from command line arguments
if ARGV.any?
  require "minitest"
  
  test_files = ARGV.flat_map do |arg|
    if arg.include?(':')
      # Handle file:line_number format for running specific tests
      file, line = arg.split(':')
      ENV["TESTOPTS"] = "--name=/.*/" if line
      file
    else
      arg
    end
  end

  # Use Ruby to run the specific test file(s)
  ruby_path = `which ruby`.strip
  rake_path = `gem which rake`.strip.sub('/lib/rake.rb', '')
  loader_path = "#{rake_path}/lib/rake/rake_test_loader.rb"
  
  exec "ruby", "-I", "lib:test:lib", loader_path, *test_files
else
  # Run the standard test task
  Rake::Task[:test].invoke
end
