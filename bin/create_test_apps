#!/usr/bin/env bash
set -euo pipefail

# This script creates test Rails applications for different Rails versions

# Create test directory if it doesn't exist
mkdir -p test/rails_apps

# Function to create a Rails app for a specific version
create_rails_app() {
  local version=$1
  local app_name="rails_${version//./_}"
  local app_path="test/rails_apps/$app_name"
  
  echo "Creating test app for Rails $version in $app_path"
  
  # Skip if app already exists
  if [ -d "$app_path" ]; then
    echo "App for Rails $version already exists, skipping..."
    return
  fi
  
  # Install the specific Rails version gem if not already installed
  if ! gem list -i "^rails$" -v "~> $version" > /dev/null 2>&1; then
    echo "Installing Rails $version..."
    gem install rails -v "~> $version.0" --no-document
  fi
  
  # Create a new Rails application
  rails _${version}.0_ new "$app_path" \
    --skip-git \
    --skip-keeps \
    --skip-action-cable \
    --skip-sprockets \
    --skip-javascript \
    --skip-hotwire \
    --skip-jbuilder \
    --skip-asset-pipeline \
    --skip-bootsnap \
    --skip-bundle \
    --api
  
  # Add our gem to the Gemfile
  cat >> "$app_path/Gemfile" << EOF

# Add LogStruct gem from local path
gem "logstruct", path: "../../.."

# Add error reporting gems for testing
gem "bugsnag", "~> 6.26"
gem "honeybadger", "~> 5.4"
gem "rollbar", "~> 3.4"
gem "sentry-ruby", "~> 5.15"

# Add testing utilities
gem "minitest-reporters"
EOF
  
  # Create LogStruct initializer
  mkdir -p "$app_path/config/initializers"
  cat > "$app_path/config/initializers/logstruct.rb" << EOF
# Configure LogStruct
LogStruct.configure do |config|
  # Enable LogStruct in all environments for testing
  config.enabled = true
  
  # Enable in all environments for testing
  config.environments = [:development, :test, :production]
  
  # Configure which environments are considered local/development
  config.local_environments = [:development, :test]
  
  # Configure integrations
  config.integrations.active_job.enabled = true
  config.integrations.action_controller.enabled = true
  config.integrations.active_record.enabled = true
  config.integrations.carrierwave.enabled = defined?(CarrierWave)
  config.integrations.shrine.enabled = defined?(Shrine)
  config.integrations.sidekiq.enabled = defined?(Sidekiq)
  
  # Enable string scrubbing filters for sensitive data
  config.filters.email_addresses = true
  config.filters.credit_card_numbers = true
  config.filters.phone_numbers = true
  config.filters.ssns = true
  config.filters.ip_addresses = true
  config.filters.mac_addresses = true
  config.filters.url_passwords = true
  
  # Configure error reporting
  # LogStruct will auto-detect error reporting services (no need to set this manually)
  # config.exception_reporting_handler = nil  # Uses MultiErrorReporter by default
end
EOF
  
  # Create a test controller with logging
  mkdir -p "$app_path/app/controllers"
  cat > "$app_path/app/controllers/test_controller.rb" << EOF
class TestController < ApplicationController
  def index
    # Test basic logging with different formats
    LogStruct.log(:user_login, user_id: 123, action: "login", email: "test@example.com")
    LogStruct.info("Test info message")
    LogStruct.warn("Test warning message")
    LogStruct.debug("Test debug message", extra_data: { key: "value" })
    
    # Test log with structured data
    LogStruct.log(LogStruct::Log::Http.new(
      method: "GET",
      path: "/test",
      status: 200,
      duration_ms: 15.5,
      message: "HTTP Request"
    ))
    
    # Test error logging
    begin
      raise StandardError, "Test error"
    rescue => e
      LogStruct.error(e, source: LogStruct::Source::App, context: { controller: "test" })
    end
    
    # Test different error reporting modes
    custom_error = StandardError.new("Custom error")
    LogStruct.handle_exception(custom_error, 
      source: LogStruct::Source::App, 
      context: { testing: true }
    )
    
    # Test tags and contexts
    LogStruct.with_context(request_id: "test-123") do
      LogStruct.info("Message with context")
    end
    
    # Return success response
    render json: { status: "ok" }
  end
  
  def test_model
    # Create a test user to trigger ActiveRecord logging
    user = User.create(name: "Test User", email: "user@example.com")
    render json: { user_id: user.id }
  end
  
  def test_job
    # Enqueue a job to test ActiveJob integration
    TestJob.perform_later("test_argument")
    render json: { job_status: "enqueued" }
  end
  
  def test_error
    # Deliberately raise an error to test error handling
    raise StandardError, "Deliberate test error"
  rescue => e
    render json: { error: e.message }, status: 500
  end
end
EOF
  
  # Add route for test controller
  cat > "$app_path/config/routes.rb" << EOF
Rails.application.routes.draw do
  get "test" => "test#index"
  get "test/model" => "test#test_model"
  get "test/job" => "test#test_job"
  get "test/error" => "test#test_error"
end
EOF

  # Create a test model
  mkdir -p "$app_path/app/models"
  cat > "$app_path/app/models/user.rb" << EOF
class User < ApplicationRecord
  validates :name, presence: true
  validates :email, presence: true
end
EOF

  # Create a migration for the User model
  mkdir -p "$app_path/db/migrate"
  timestamp=$(date +%Y%m%d%H%M%S)
  cat > "$app_path/db/migrate/${timestamp}_create_users.rb" << EOF
class CreateUsers < ActiveRecord::Migration[${version}.0]
  def change
    create_table :users do |t|
      t.string :name
      t.string :email
      t.timestamps
    end
  end
end
EOF

  # Create a test job
  mkdir -p "$app_path/app/jobs"
  cat > "$app_path/app/jobs/test_job.rb" << EOF
class TestJob < ApplicationJob
  queue_as :default

  def perform(arg)
    # Test logging in a job
    LogStruct.info("Processing job", argument: arg)
    
    # Simulate some work
    sleep 0.1
    
    # Test error handling in a job
    begin
      raise StandardError, "Test job error"
    rescue => e
      LogStruct.error(e, source: LogStruct::Source::Job, context: { job_class: self.class.name })
    end
  end
end
EOF
  
  # Create integration test
  mkdir -p "$app_path/test/integration"
  cat > "$app_path/test/integration/logstruct_test.rb" << EOF
require "test_helper"

class LogstructTest < ActionDispatch::IntegrationTest
  setup do
    # Prepare database
    ActiveRecord::Migration.check_pending!
  end
  
  test "basic logging and configuration" do
    # Verify LogStruct is properly configured
    assert LogStruct.enabled?
    assert LogStruct.config.filters.email_addresses
    assert LogStruct.config.integrations.active_job.enabled
  end
  
  test "general logging works" do
    # Mock the logger to capture logs
    log_messages = []
    
    Rails.logger.stub :info, ->(message) { log_messages << message } do
      get "/test"
      assert_response :success
    end
    
    # Verify logs have expected content
    assert_equal "ok", JSON.parse(response.body)["status"]
    
    # Check for structured logs
    found_user_login = false
    found_http_log = false
    found_error_log = false
    found_context_log = false
    
    log_messages.each do |msg|
      parsed = JSON.parse(msg) rescue nil
      next unless parsed
      
      # Check for basic logging
      if parsed["evt"] == "user_login"
        found_user_login = true
        assert_equal 123, parsed["user_id"]
        assert_equal "login", parsed["action"]
        # Email should be scrubbed
        assert_includes parsed["email"], "[EMAIL]"
      end
      
      # Check for HTTP logging
      if parsed["evt"] == "http_request"
        found_http_log = true
        assert_equal "GET", parsed["method"]
        assert_equal 200, parsed["status"]
      end
      
      # Check for error logging
      if parsed["evt"] == "exception"
        found_error_log = true
        assert_equal "StandardError", parsed["err_class"]
      end
      
      # Check for context
      if parsed["request_id"] == "test-123"
        found_context_log = true
      end
    end
    
    # Verify all log types were found
    assert found_user_login, "Should include user_login event"
    assert found_http_log, "Should include HTTP request event"
    assert found_error_log, "Should include exception event"
    assert found_context_log, "Should include contextual log"
  end
  
  test "active record integration works" do
    log_messages = []
    
    Rails.logger.stub :info, ->(message) { log_messages << message } do
      get "/test/model"
      assert_response :success
    end
    
    found_db_query = false
    
    log_messages.each do |msg|
      parsed = JSON.parse(msg) rescue nil
      next unless parsed
      
      if parsed["evt"] == "sql_query"
        found_db_query = true
        assert_includes parsed["query"].downcase, "insert into"
        assert_includes parsed["query"].downcase, "users"
      end
    end
    
    assert found_db_query, "Should log SQL queries"
  end
  
  test "active job integration works" do
    log_messages = []
    
    Rails.logger.stub :info, ->(message) { log_messages << message } do
      get "/test/job"
      assert_response :success
      # Wait for job to execute
      perform_enqueued_jobs
    end
    
    found_job_enqueue = false
    found_job_process = false
    
    log_messages.each do |msg|
      parsed = JSON.parse(msg) rescue nil
      next unless parsed
      
      if parsed["evt"] == "job_enqueue"
        found_job_enqueue = true
        assert_equal "TestJob", parsed["job_class"]
      end
      
      if parsed["msg"] == "Processing job"
        found_job_process = true
        assert_equal "test_argument", parsed["argument"]
      end
    end
    
    assert found_job_enqueue, "Should log job enqueuing"
    assert found_job_process, "Should log job processing"
  end
  
  test "error handling works" do
    log_messages = []
    
    Rails.logger.stub :error, ->(message) { log_messages << message } do
      get "/test/error"
      assert_response :status => 500
    end
    
    # Verify error logs have expected content
    assert_match "Deliberate test error", JSON.parse(response.body)["error"]
    
    found_error_log = false
    log_messages.each do |msg|
      parsed = JSON.parse(msg) rescue nil
      next unless parsed
      
      if parsed["evt"] == "exception"
        found_error_log = true
        assert_equal "StandardError", parsed["err_class"]
        assert_equal "Deliberate test error", parsed["message"]
      end
    end
    
    assert found_error_log, "Should log exceptions"
  end
  
  private
  
  def perform_enqueued_jobs
    enqueued_jobs = ActiveJob::Base.queue_adapter.enqueued_jobs
    enqueued_jobs.each do |job|
      ActiveJob::Base.execute job
    end
  end
end
EOF
  
  # Update test_helper to configure minitest-reporters
  cat >> "$app_path/test/test_helper.rb" << EOF

# Configure minitest-reporters
require "minitest/reporters"
Minitest::Reporters.use! Minitest::Reporters::SpecReporter.new
EOF
  
  # Install dependencies
  cd "$app_path" && bundle install
  
  echo "Created test app for Rails $version in $app_path"
}

# Create test apps for different Rails versions
create_rails_app "7.0"
create_rails_app "7.1"
create_rails_app "8.0"

echo "All test apps created successfully!"