#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
begin
  require "listen"
rescue LoadError
  puts "The listen gem is required for this script."
  puts "Please add it to your Gemfile:"
  puts "  gem 'listen', require: false"
  puts "And run: bundle install"
  exit 1
end

def run_tapioca_dsl
  puts "Running tapioca dsl..."
  system("./bin/tapioca dsl")
end

run_tapioca_dsl

puts "Starting spec file watcher..."
puts "Watching for changes in the spec directory..."
puts "Will run './bin/tapioca dsl' when files change."
puts "Press Ctrl-C to stop."

listener = Listen.to("spec/") do |modified, added, removed|
  if (modified + added + removed).any?
    changed_files = (modified + added + removed).join(", ")
    puts "\n#{Time.now}: Changes detected in: #{changed_files}"

    run_tapioca_dsl

    puts "Tapioca dsl completed at #{Time.now}"
    puts "Watching for more changes..."
  end
end

listener.start
sleep # Keep the script running
