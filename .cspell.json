{
  "ignorePaths": [
    "sorbet/rbi/annotations/**",
    "sorbet/rbi/dsl/**",
    "sorbet/rbi/gems/**",
    "vendor/**",
    "node_modules/**"
  ],
  "overrides": [],
  "ignoreRegExpList": [
    "/\\b[A-Za-z]+&apos;[A-Za-z]+\\b/g",
    "/\\\\e\\[[0-9;]*m/g"
  ],
  "useGitignore": true,
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    },
    {
      "name": "lockfile-words-root",
      "path": "./.cspell/generated-lockfile-words-root.txt",
      "addWords": false
    }
  ],
  "dictionaries": [
    "project-words",
    "lockfile-words-root"
  ]
}
